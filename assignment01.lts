// Assignment 01 - lift

// N floors (0 = ground floor), 2 users: a and b
const N = 3
range Floors = 0..N-1

/* Un utente chiama l'ascensore al piano f e aspetta che arrivi,
   poi entra, sceglie un piano d ed esce a quel piano.
   Se suona l'allarme: la chiamata viene annullata (cancel)
   oppure, se e' dentro, l'utente viene evacuato (evacuate). */
USER       = (call[f:Floors] -> WAITING[f]),
WAITING[f:Floors] = (arrive[f] -> AT_DOOR | cancel -> USER),
AT_DOOR    = (enter -> INSIDE | cancel -> USER),
INSIDE     = (select[d:Floors] -> RIDING[d] | evacuate -> USER),
RIDING[d:Floors]  = (exit[d] -> USER | evacuate -> USER).

||USERS = (a:USER || b:USER).

/* coda FIFO */
QUEUE = EMPTY,
EMPTY = (a.call[Floors] -> QA | b.call[Floors] -> QB),
QA    = (a.serve -> EMPTY | b.call[Floors] -> QAB),
QB    = (b.serve -> EMPTY | a.call[Floors] -> QBA),
//caso in cui viene chiamato prima da A e poi da B
QAB   = (a.serve -> QB),
//viceversa
QBA   = (b.serve -> QA).

ALARM = (alarm -> solved -> ALARM).

/* L'ascensore serve un utente alla volta e torna in IDLE quando l'utente esce.
   Se parte l'allarme, l'utente viene fatto scendere e l'ascensore
   aspetta che l'allarme sia risolto. Gli spostamenti tra i piani sono
   astratti: arrive[f] = l'ascensore e' arrivato al piano f. */
LIFT = IDLE,
IDLE = (a.serve -> A_GO | b.serve -> B_GO | alarm -> STOPPED),

A_GO   = (a.arrive[f:Floors] -> A_DOOR | alarm -> a.cancel -> STOPPED),
A_DOOR = (a.enter -> A_IN | alarm -> a.cancel -> STOPPED),
A_IN   = (a.select[d:Floors] -> A_RIDE[d] | alarm -> a.evacuate -> STOPPED),
A_RIDE[d:Floors] = (a.exit[d] -> IDLE | alarm -> a.evacuate -> STOPPED),

B_GO   = (b.arrive[f:Floors] -> B_DOOR | alarm -> b.cancel -> STOPPED),
B_DOOR = (b.enter -> B_IN | alarm -> b.cancel -> STOPPED),
B_IN   = (b.select[d:Floors] -> B_RIDE[d] | alarm -> b.evacuate -> STOPPED),
B_RIDE[d:Floors] = (b.exit[d] -> IDLE | alarm -> b.evacuate -> STOPPED),

STOPPED = (solved -> IDLE).

||LIFT_SYSTEM = (USERS || QUEUE || LIFT || ALARM).


/* ---------------- fluenti ---------------- */

// l'allarme e' attivo da quando scatta a quando viene risolto
fluent ALARM_ON = <alarm, solved>

// l'utente e' nell'ascensore da quando entra a quando esce (o viene evacuato)
fluent A_IN_LIFT = <a.enter, {a.exit[Floors], a.evacuate}>
fluent B_IN_LIFT = <b.enter, {b.exit[Floors], b.evacuate}>

// l'utente ha chiamato l'ascensore e questo non e' ancora arrivato (o la chiamata e' stata annullata)
fluent A_CALLED = <a.call[Floors], {a.arrive[Floors], a.cancel}>
fluent B_CALLED = <b.call[Floors], {b.arrive[Floors], b.cancel}>

// l'utente ha scelto un piano e non e' ancora uscito (o evacuato)
fluent A_SELECTED = <a.select[Floors], {a.exit[Floors], a.evacuate}>
fluent B_SELECTED = <b.select[Floors], {b.exit[Floors], b.evacuate}>

// l'utente aspetta di entrare nell'ascensore
fluent A_WAITING = <a.call[Floors], {a.enter, a.cancel}>
fluent B_WAITING = <b.call[Floors], {b.enter, b.cancel}>


/* ---------------- proprieta' ---------------- */

/* 1) solo un utente alla volta puo' utilizzare l'ascensore */
assert MUTEX = []!(A_IN_LIFT && B_IN_LIFT)

// la stessa cosa come property (si controlla con Check > Safety)
property ONE_AT_A_TIME = (a.enter -> A_IN | b.enter -> B_IN),
A_IN = (a.exit[Floors] -> ONE_AT_A_TIME | a.evacuate -> ONE_AT_A_TIME),
B_IN = (b.exit[Floors] -> ONE_AT_A_TIME | b.evacuate -> ONE_AT_A_TIME).

||CHECK_ONE_AT_A_TIME = (LIFT_SYSTEM || ONE_AT_A_TIME).

/* 2) se qualcuno chiama l'ascensore, prima o poi arriva (tranne con allarme) */
assert A_LIFT_ARRIVES = [](A_CALLED -> <>(!A_CALLED || ALARM_ON))
assert B_LIFT_ARRIVES = [](B_CALLED -> <>(!B_CALLED || ALARM_ON))

/* 3) se un utente dentro seleziona un piano, prima o poi ci arriva (tranne con allarme) */
assert A_SELECT_ARRIVES = [](A_SELECTED -> <>(!A_SELECTED || ALARM_ON))
assert B_SELECT_ARRIVES = [](B_SELECTED -> <>(!B_SELECTED || ALARM_ON))

/* 4) un utente che aspetta l'ascensore prima o poi lo ottiene (tranne con allarme) */
assert A_GETS_LIFT = [](A_WAITING -> <>(a.enter || ALARM_ON))
assert B_GETS_LIFT = [](B_WAITING -> <>(b.enter || ALARM_ON))
